# Copy this file to .env and fill in the real values, or just drop in the .env
# you were sent. The demo will not start without it.
#
# The file must be named exactly ".env" and sit in this folder, next to run.bat.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_SOL_DEPLOYMENT=
AZURE_OPENAI_LUNA_DEPLOYMENT=
AZURE_OPENAI_TERRA_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional provider switches. Both default to azure.
# EMBED_PROVIDER=local runs BAAI/bge-m3 on this machine and reads index/local and
# index/stm32/local instead of the Azure indexes. Build them first with
# python -m scripts.embed_and_index (see CLAUDE.md).
# LLM_PROVIDER=codex sends router and answer calls through `codex exec` on your
# ChatGPT login. Answers arrive in one chunk instead of streaming.
# EMBED_PROVIDER=local
# LLM_PROVIDER=codex
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# CODEX_MODEL=gpt-6.2-sol
# CODEX_BIN=
